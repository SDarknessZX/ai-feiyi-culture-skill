# OpenCV YuNet 人脸检测（民族变装强制校验）
# 默认直接调用本地 Python/OpenCV；可选远程接口仍接收 multipart 字段 image。
FACE_DETECT_ENDPOINT=
FACE_DETECT_API_KEY=
FACE_DETECT_API_KEY_HEADER=Authorization
FACE_DETECT_TIMEOUT_MS=120000
FACE_DETECT_CACHE_TTL_MS=900000
FACE_DETECT_PYTHON=
FACE_DETECT_PYTHON_ARGS=
FACE_DETECT_LOCAL_TIMEOUT_MS=30000
FACE_DETECT_MODEL_PATH=server/models/face_detection_yunet_2023mar.onnx
FACE_DETECT_SCORE_THRESHOLD=0.8
FACE_DETECT_NMS_THRESHOLD=0.3
FACE_DETECT_TOP_K=5000

# 火山 TOS：上传用户图片并长期归档生成视频
