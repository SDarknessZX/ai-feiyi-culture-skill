# 服务
PORT=8790
MODEL_PROVIDER=mock
CORS_ORIGIN=
CREATE_RATE_LIMIT=20

# 咪咕集成合规信息
VITE_SERVICE_PROVIDER_NAME=咪咕音乐有限公司
VITE_PRIVACY_POLICY_URL=https://passport.migu.cn/portal/privacy/protocol?sourceid=220024
AIGC_CONTENT_PRODUCER=001191510100321561677C00000
# 可选：配置后用于 ReservedCode1/ReservedCode2 的 HMAC 完整性校验
AIGC_SIGNING_SECRET=

# 火山方舟：图片处理、视频生成、美食理解
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=
ARK_VIDEO_MODEL=doubao-seedance-2-0-mini-260615
ARK_VIDEO_RESOLUTION=720p
ARK_IMAGE_API_KEY=
ARK_IMAGE_MODEL=doubao-seedream-5-0-260128
ARK_IMAGE_SIZE=2K
ARK_IMAGE_WATERMARK=true
ARK_LLM_API_KEY=
ARK_LLM_MODEL=doubao-seed-2-0-mini-260428

# OpenCV YuNet 人脸检测（民族变装强制校验）
# 默认直接调用本地 Python/OpenCV；可选远程接口仍接收 multipart 字段 image。
FACE_DETECT_ENDPOINT=
FACE_DETECT_API_KEY=
FACE_DETECT_API_KEY_HEADER=Authorization
FACE_DETECT_TIMEOUT_MS=120000
FACE_DETECT_CACHE_TTL_MS=900000
# 留空时 Windows 自动尝试 3.11、3.10，Linux/macOS 自动尝试 python3
FACE_DETECT_PYTHON=
FACE_DETECT_PYTHON_ARGS=
FACE_DETECT_LOCAL_TIMEOUT_MS=30000
FACE_DETECT_MODEL_PATH=server/models/face_detection_yunet_2023mar.onnx
# YuNet 人脸置信度阈值；0.65 可减少黑白、柔光和低对比度正脸的漏检。
FACE_DETECT_SCORE_THRESHOLD=0.65
FACE_DETECT_NMS_THRESHOLD=0.3
FACE_DETECT_TOP_K=5000

# 咪咕音乐 AIGC 自发展开放接入（Token计费版 + Amber SDK）—— SKILL：非遗文化
# 登录跳转、权益查询、Token预扣、成功/失败结果上报、取消撤销、发布跳转和 Amber 埋点均已接入
MIGU_AIGC_APP_ID=
MIGU_AIGC_APP_SECRET=
MIGU_CHANNEL_CODE=
MIGU_PROJECT_ID=
# 以下两项是登录回调未返回对应参数时的服务端兜底；发布页文档均标注为非必填
# 水印 ID 不要用 WATERMARKFLAG=3 代替
MIGU_RELEASE_ID=
MIGU_WATERMARK_ID=
MIGU_CALLBACK_URL=
# Token 计费服务端接口地址，与统一审核共用同一个 IP:端口网关（不是域名）
# 线网端口 31010，测试环境端口是 31011
MIGU_TOKEN_API_BASE_URL=http://218.200.229.108:31010
# 数智人和AI视频彩铃包月《登陆接口》：用来现取 cToken，域名/签名规则跟上面 Token 计费接口不是一回事
MIGU_CHANNEL_LOGIN_BASE_URL=https://hz.migu.cn
MIGU_CHANNEL_LOGIN_SIGN_KEY=
MIGU_CHANNEL_LOGIN_KEY=
# Token 计费网关只有部署在 IP 白名单机器上才能打通，本地/未过白名单的机器请保持 false
MIGU_TOKEN_GATING_ENABLED=false
MIGU_MODEL_VALUE_COSTUME=
MIGU_MODEL_VALUE_FOOD=
MIGU_MODEL_VALUE_PAINTING=

# 以上几个值的 VITE_ 副本，给前端 Amber 埋点用（appId/projectId/channelCode 不是密钥，写进前端包没问题）
VITE_MIGU_AIGC_APP_ID=
VITE_MIGU_PROJECT_ID=
VITE_MIGU_CHANNEL_CODE=
# Amber _accountId：测试环境和生产环境不是同一个值，文档里各给了一个
VITE_AMBER_ACCOUNT_ID=
# 清源行动上报地址：生产 https://uem.migu.cn:18088/udcc/qyWebData.html，测试 http://117.135.165.39:8088/udcc/qyWebData.html
VITE_AMBER_UPLOAD_URL=https://uem.migu.cn:18088/udcc/qyWebData.html

# 咪咕统一审核（机审）：创作输入图片 + 生成结果视频过审
# 接口地址跟 Token 计费服务端接口是同一个 IP:端口网关
AUDIT_API_BASE_URL=http://218.200.229.108:31010
AUDIT_ACCOUNT=
AUDIT_APP_KEY=
AUDIT_CALLBACK_NAME=
# 机审服务本身请求失败/超时（不是"审核不通过"）时是否放行，默认 false 更保守（直接拦截）
AUDIT_FAIL_OPEN_ON_ERROR=false
AUDIT_TIMEOUT_MS=20000

# 火山 TOS：上传用户图片并长期归档生成视频
TOS_ACCESS_KEY_ID=
TOS_SECRET_ACCESS_KEY=
TOS_REGION=cn-beijing
TOS_BUCKET=
TOS_ENDPOINT=tos-cn-beijing.volces.com
TOS_PUBLIC_BASE_URL=https://你的桶名.tos-cn-beijing.volces.com
